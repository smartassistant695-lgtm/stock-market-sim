# Copy this file to ".env" for local scripts. ".env" is ignored by git.
# On the live site, enter these in Vercel > Project > Settings > Environment Variables instead.

# Google Apps Script web app URL (ends in /exec)
SHEETS_URL=

# Alpaca Market Data API keys (used from Stage 1). Alpaca gives you two values:
# an "API Key ID" and a "Secret Key".
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
